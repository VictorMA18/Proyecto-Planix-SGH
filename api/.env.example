# Cadena de conexión a PostgreSQL en Docker (puerto 5434)
DATABASE_URL="postgresql://sgh:sgh@localhost:5434/sgh?schema=public"

# Credenciales de Clerk Backend (fase 1)
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# Puerto del Servidor Backend NestJS
PORT=3000

# Cloudinary para los adjuntos de tareas (fase 3)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Notificaciones push (fase 4). Sin ellas la API arranca: las notificaciones quedan en la bandeja.
RABBITMQ_URL=
# Solo si se activa la seguridad mejorada del proyecto en Expo
EXPO_ACCESS_TOKEN=
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto:responsable@dominio o la URL del sitio
VAPID_SUBJECT=
