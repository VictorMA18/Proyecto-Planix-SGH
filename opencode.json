{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "StitchMCP": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "https://stitch.googleapis.com/mcp",
        "--header",
        "X-Goog-Api-Key: {env:STITCH_API_KEY}"
      ],
      "enabled": true
    }
  }
}
